# Backend Environment Variables Template
# Copy these to Render Environment Variables section

# Server Configuration
PORT=3000
NODE_ENV=production

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Frontend Configuration (for CORS)
# Use your Vercel frontend URL here, not the Render backend URL.
VITE_APP_ORIGIN=https://ccdinventorysystem.vercel.app
VITE_APP_DOMAIN=ccdinventorysystem.vercel.app
